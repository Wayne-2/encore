rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Emoji reactions are stored per user under an item's `reactions`
    // subcollection: { emojis: ['👍', '🔥'] }.
    function validReactionEmojis() {
      return request.resource.data.emojis is list
        && request.resource.data.emojis.size() > 0
        && request.resource.data.emojis.size() <= 9
        && request.resource.data.emojis.hasOnly([
          '👍', '❤️', '😂', '🎉', '👏', '🙌', '🔥', '😮', '😢'
        ]);
    }

    // Every user owns a single profile document at users/{uid}.
    // Level (a field on this doc) is the grouping key used across the app,
    // so any signed-in user may read profiles; only the owner may write.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;

      // Personal library collections. Only the owner can read or write them.
      match /savedMaterials/{materialId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.materialId == materialId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.kind in ['pdf', 'image']
          && request.resource.data.savedAt == request.time
          && request.resource.data.keys().hasOnly([
            'materialId', 'title', 'kind', 'savedAt'
          ]);
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /libraryHighlights/{highlightId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.materialId is string
          && request.resource.data.materialId.size() > 0
          && request.resource.data.materialTitle is string
          && request.resource.data.materialTitle.size() <= 200
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly([
            'materialId', 'materialTitle', 'text', 'createdAt'
          ]);
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /libraryHistory/{materialId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.materialId == materialId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.kind in ['pdf', 'image']
          && request.resource.data.readCount == 1
          && request.resource.data.progress == 0
          && request.resource.data.lastReadAt == request.time
          && request.resource.data.keys().hasOnly([
            'materialId', 'title', 'kind', 'readCount', 'progress',
            'lastReadAt'
          ]);
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.materialId == materialId
          && request.resource.data.progress is number
          && request.resource.data.progress >= 0
          && request.resource.data.progress <= 1
          && (
            (
              request.resource.data.readCount == resource.data.readCount + 1
              && request.resource.data.lastReadAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['readCount', 'lastReadAt', 'progress'])
            ) || (
              request.resource.data.readCount == resource.data.readCount
              && request.resource.data.lastReadAt == resource.data.lastReadAt
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['progress'])
            )
          );
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public library documents. Any signed-in user can read; the uploader
    // creates an immutable text document. Original files are never stored.
    match /libraryMaterials/{materialId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 80
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 200
        && request.resource.data.kind in ['pdf', 'image']
        && request.resource.data.extractedText is string
        && request.resource.data.extractedText.size() > 0
        && request.resource.data.extractedText.size() <= 800000
        && request.resource.data.textUrl is string
        && request.resource.data.textUrl.size() > 0
        && request.resource.data.textUrl.size() <= 2048
        && request.resource.data.textFileName is string
        && request.resource.data.textFileName.size() > 0
        && request.resource.data.textFileName.size() <= 200
        && request.resource.data.uploaderName is string
        && request.resource.data.uploaderName.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'title', 'subject', 'fileName', 'kind', 'extractedText',
          'textUrl', 'textFileName', 'uploaderId', 'uploaderName',
          'createdAt'
        ]);
      allow update, delete: if false;
    }

    // Announcements are scoped to a department + level group. Only users in
    // that group may read a post; authors create and delete their own posts.
    // Editing is not supported.
    match /announcements/{announcementId} {
      function profile() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function departmentCode() {
        let stored = profile().department is string
          ? profile().department.trim()
          : '';
        let key = stored.lower();
        return key == 'computer science' || key == 'csc' ? 'CSC'
          : key == 'software engineering' || key == 'soe' ? 'SOE'
          : key == 'cyber security' || key == 'cybersecurity' || key == 'cyb' ? 'CYB'
          : key == 'information technology' || key == 'ift' ? 'IFT'
          : stored;
      }
      function groupLevel() {
        return profile().level is string ? profile().level.trim() : '';
      }
      function hasGroup() {
        return departmentCode() != '' && groupLevel() != '';
      }
      function announcementData() {
        return get(/databases/$(database)/documents/announcements/$(announcementId)).data;
      }
      function inGroup() {
        return request.auth != null
          && hasGroup()
          && announcementData().department == departmentCode()
          && announcementData().level == groupLevel();
      }
      allow read: if request.auth != null
        && hasGroup()
        && resource.data.department == departmentCode()
        && resource.data.level == groupLevel();
      allow create: if request.auth != null
        && hasGroup()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.department == departmentCode()
        && request.resource.data.level == groupLevel()
        && request.resource.data.author is string
        && request.resource.data.body is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      match /reactions/{userId} {
        allow read: if inGroup();
        allow create, update: if inGroup()
          && userId == request.auth.uid
          && validReactionEmojis();
        allow delete: if inGroup() && userId == request.auth.uid;
      }

      // Comments inherit the announcement's group. Only members of the same
      // department + level may read or post; authors delete their own replies.
      match /comments/{commentId} {
        function announcement() {
          return get(/databases/$(database)/documents/announcements/$(announcementId)).data;
        }
        allow read: if request.auth != null
          && hasGroup()
          && announcement().department == departmentCode()
          && announcement().level == groupLevel();
        allow create: if request.auth != null
          && hasGroup()
          && announcement().department == departmentCode()
          && announcement().level == groupLevel()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;

        match /reactions/{userId} {
          allow read: if inGroup();
          allow create, update: if inGroup()
            && userId == request.auth.uid
            && validReactionEmojis();
          allow delete: if inGroup() && userId == request.auth.uid;
        }
      }
    }

    // Contact requests gate DMs. A pair has one request document keyed by
    // their sorted UIDs, so reciprocal requests cannot create duplicates.
    // Only the recipient can accept, and accepting also creates the chat.
    match /contactRequests/{requestId} {
      // A get for the deterministic request ID is how senders check whether
      // the pair already has a request. A missing document has no resource,
      // so allow that lookup while keeping existing requests private.
      allow get: if request.auth != null
        && (resource == null
          || request.auth.uid in resource.data.participants);
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.fromUid is string
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0]
          != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.toUid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.chatId is string
        && request.resource.data.chatId.size() > 0
        && request.resource.data.respondedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'chatId', 'respondedAt', 'updatedAt'
        ]);
      allow delete: if request.auth != null
        && resource.data.status == 'pending'
        && (request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid);
    }

    // Durable push-notification jobs. Clients may only create their own
    // pending job; delivery state is owned by the Worker's service account.
    match /notificationOutbox/{outboxId} {
      function validTarget() {
        let data = request.resource.data;
        return (data.type == 'contact_request'
            && data.requestId is string
            && data.requestId.size() > 0)
          || (data.type == 'chat_message'
            && data.chatId is string
            && data.chatId.size() > 0
            && data.messageId is string
            && data.messageId.size() > 0);
      }

      allow create: if request.auth != null
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.attempts == 0
        && request.resource.data.createdAt == request.time
        && validTarget()
        && request.resource.data.keys().hasOnly([
          'type', 'actorId', 'status', 'attempts', 'requestId', 'chatId',
          'messageId', 'createdAt', 'nextAttemptAt', 'updatedAt'
        ]);
      allow read, update, delete: if false;
    }

    // Direct chats and groups. A chat is readable and writable only by its
    // members. DM IDs are deterministic, which prevents duplicate threads.
    match /chats/{chatId} {
      function isMember() {
        return request.auth != null
          && request.auth.uid in resource.data.members;
      }
      function validDmCreate() {
        let data = request.resource.data;
        return data.type == 'dm'
          && data.members is list
          && data.members.size() == 2
          && data.members[0] != data.members[1]
          && request.auth.uid in data.members
          && data.createdAt == request.time;
      }
      function validGroupCreate() {
        let data = request.resource.data;
        return data.type == 'group'
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 80
          && data.members is list
          && data.members.size() >= 2
          && data.members.size() <= 100
          && request.auth.uid in data.members
          && data.memberProfiles is map
          && data.admins is list
          && data.admins.size() > 0
          && data.admins.hasOnly(data.members)
          && request.auth.uid in data.admins
          && data.createdBy == request.auth.uid
          && data.createdAt == request.time;
      }
      function isAdmin() {
        return request.auth != null
          && request.auth.uid in resource.data.admins;
      }
      function isGroup() {
        return resource.data.type == 'group';
      }
      function chatActivityFields() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function onlyChatActivity() {
        return chatActivityFields().hasOnly([
          'lastMessage', 'lastMessageId', 'lastMessageType', 'lastMessageAt',
          'lastSenderId', 'lastSenderAnonymous', 'updatedAt', 'lastReadAt',
          'unread', 'typing', 'clearedAt', 'memberProfiles'
        ]);
      }
      function validAdminGroupUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        return after.type == 'group'
          && after.createdBy == before.createdBy
          && after.title is string
          && after.title.size() > 0
          && after.title.size() <= 80
          && after.get('description', '') is string
          && after.get('description', '').size() <= 500
          && after.members is list
          && after.members.size() <= 100
          && after.admins is list
          && after.admins.hasOnly(after.members)
          && (after.members.size() == 0 || after.admins.size() > 0)
          && after.memberProfiles is map
          && after.unread is map
          && after.lastReadAt is map
          && after.typing is map
          && after.clearedAt is map
          && after.get('membersCanPost', true) is bool
          && after.get('anonymousMessagesEnabled', false) is bool
          && after.get('membersCanAddMembers', true) is bool;
      }
      function validMemberGroupAdd() {
        let before = resource.data;
        let after = request.resource.data;
        return after.type == 'group'
          && before.get('membersCanAddMembers', true) == true
          && after.members is list
          && after.members.size() > before.members.size()
          && after.members.size() <= 100
          && after.members.hasAll(before.members)
          && after.admins == before.admins
          && after.createdBy == before.createdBy
          && after.title == before.title
          && after.get('description', '') == before.get('description', '')
          && after.get('membersCanPost', true)
            == before.get('membersCanPost', true)
          && after.get('anonymousMessagesEnabled', false)
            == before.get('anonymousMessagesEnabled', false)
          && after.get('membersCanAddMembers', true)
            == before.get('membersCanAddMembers', true)
          && after.memberProfiles is map
          && after.unread is map;
      }
      function validGroupLeave() {
        let before = resource.data;
        let after = request.resource.data;
        return after.type == 'group'
          && !(request.auth.uid in after.members)
          && before.members.hasAll(after.members)
          && after.members.size() == before.members.size() - 1
          && after.admins is list
          && after.admins.hasOnly(after.members)
          && (after.members.size() == 0 || after.admins.size() > 0)
          && after.createdBy == before.createdBy
          && after.title == before.title
          && after.get('description', '') == before.get('description', '')
          && after.get('photoUrl', '') == before.get('photoUrl', '')
          && after.get('membersCanPost', true)
            == before.get('membersCanPost', true)
          && after.get('anonymousMessagesEnabled', false)
            == before.get('anonymousMessagesEnabled', false)
          && after.get('membersCanAddMembers', true)
            == before.get('membersCanAddMembers', true)
          && after.memberProfiles is map
          && (request.auth.uid in before.admins
            || after.admins == before.admins);
      }

      // A read of a not-yet-created chat (opening a new DM) must succeed so
      // the client can listen before the first message creates the document.
      allow get: if request.auth != null
        && (resource == null || isMember());
      allow list: if isMember();
      allow create: if request.auth != null
        && (validDmCreate() || validGroupCreate());
      allow update: if isMember()
        && request.resource.data.type == resource.data.type
        && (
          // Normal sending, read receipts, typing and clearing activity.
          (request.resource.data.members == resource.data.members
            && request.resource.data.get('admins', [])
              == resource.data.get('admins', [])
            && request.resource.data.get('createdBy', null)
              == resource.data.get('createdBy', null)
            && (resource.data.type == 'dm'
              || request.resource.data.title == resource.data.title
              || isAdmin())
            && onlyChatActivity())
          // Admins manage members, admins, permissions and group info.
          || (isGroup() && isAdmin() && validAdminGroupUpdate())
          // Members may add people when the admin allows it.
          || (isGroup() && validMemberGroupAdd())
          // Members may remove only themselves from the group.
          || (isGroup() && validGroupLeave())
        );
      allow delete: if false;

      match /messages/{messageId} {
        function chat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function isChatMember() {
          return request.auth != null
            && request.auth.uid in chat().members;
        }
        function canPost() {
          return chat().type == 'dm'
            || chat().get('membersCanPost', true) == true
            || request.auth.uid in chat().admins;
        }
        function writeFields() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        allow read: if isChatMember();
        allow create: if isChatMember()
          && canPost()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.type in ['text', 'image']
          && request.resource.data.createdAt == request.time
          && (!request.resource.data.keys().hasAny(['imageUrl'])
            || request.resource.data.imageUrl is string)
          && (!request.resource.data.keys().hasAny(['anonymous'])
            || request.resource.data.anonymous is bool)
          && (request.resource.data.get('anonymous', false) == false
            || (chat().get('anonymousMessagesEnabled', false) == true
              && request.resource.data.senderName == 'Anonymous Sender'
              && request.resource.data.senderUsername == ''));
        allow update: if isChatMember()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.type in ['text', 'image', 'deleted']
          && writeFields().hasOnly([
            'text', 'editedAt', 'imageUrl', 'deleted', 'deletedAt', 'type',
            'replyTo'
          ]);
        allow delete: if isChatMember()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Trends are campus-wide: any signed-in user can read them. Comments and
    // emoji reactions live in subcollections and persist for everyone.
    match /trends/{trendId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.media is list
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;

        match /reactions/{userId} {
          allow read: if request.auth != null;
          allow create, update: if request.auth != null
            && userId == request.auth.uid
            && validReactionEmojis();
          allow delete: if request.auth != null
            && userId == request.auth.uid;
        }
      }

      match /reactions/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && userId == request.auth.uid
          && validReactionEmojis();
        allow delete: if request.auth != null
          && userId == request.auth.uid;
      }
    }

    // Activities are visible to every signed-in user. The date is a calendar
    // day; the client greys out activities whose date has passed.
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.date is timestamp
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }
  }
}
